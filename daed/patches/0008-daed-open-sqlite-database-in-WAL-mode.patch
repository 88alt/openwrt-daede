From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kenzok8 <kenzok8@gmail.com>
Date: Fri, 7 Aug 2026 23:39:58 +0800
Subject: [PATCH] daed: open sqlite database in WAL mode
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

订阅自动更新写库时，WebUI 登录查询被锁 5 秒后报 database is locked。

开 WAL 并把 busy_timeout 提到 30 秒，读不再被写事务阻塞。
---
 pkg/sqlite/sqlite_mipsarch.go | 4 +++-
 pkg/sqlite/sqlite_others.go   | 4 +++-
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/pkg/sqlite/sqlite_mipsarch.go b/pkg/sqlite/sqlite_mipsarch.go
index 7b8c1b4..7c86194 100644
--- a/pkg/sqlite/sqlite_mipsarch.go
+++ b/pkg/sqlite/sqlite_mipsarch.go
@@ -10,6 +10,8 @@ import (
 	"gorm.io/gorm"
 )
 
+const pragmas = "?_journal_mode=WAL&_busy_timeout=30000&_synchronous=NORMAL"
+
 func Open(dsn string) gorm.Dialector {
-	return sqlite.Open(dsn)
+	return sqlite.Open(dsn + pragmas)
 }
diff --git a/pkg/sqlite/sqlite_others.go b/pkg/sqlite/sqlite_others.go
index 4598651..c1a39f1 100644
--- a/pkg/sqlite/sqlite_others.go
+++ b/pkg/sqlite/sqlite_others.go
@@ -7,6 +7,8 @@ import (
 	"gorm.io/gorm"
 )
 
+const pragmas = "?_pragma=journal_mode(WAL)&_pragma=busy_timeout(30000)&_pragma=synchronous(NORMAL)"
+
 func Open(dsn string) gorm.Dialector {
-	return sqlite.Open(dsn)
+	return sqlite.Open(dsn + pragmas)
 }
